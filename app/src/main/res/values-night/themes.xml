<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native OS Android 12+ Splash Screen Theme (Dark Mode) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.BSADDateConverterAgeCalculator</item>
    </style>

    <!-- Dark theme -->
    <style name="Theme.BSADDateConverterAgeCalculator" parent="android:Theme.Material.NoActionBar">
        <!-- Make window background explicitly dark immediately -->
        <item name="android:windowBackground">#121212</item>
        <item name="android:colorBackground">#121212</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
